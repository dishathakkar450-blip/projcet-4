def input_1d_data():
    """
    Prompts the user to enter space-separated numbers for a 1-D list
    or choose sample data.
    Returns a list of floats/ints.
    """
    print("\nData Input Options:")
    print("  1. Enter values manually")
    print("  2. Use sample data  [34, 12, 56, 78, 43, 21, 90]")
    choice = input("Choose an option: ").strip()

    if choice == "2":
        data = [34, 12, 56, 78, 43, 21, 90]
        print(f"Sample data loaded: {data}")
    else:
        raw  = input("Enter data for a 1D array (separated by spaces): ")
        data = [float(x) if '.' in x else int(x) for x in raw.split()]

    return data


def input_2d_data():
    """
    Prompts the user to enter a 2-D (nested) list row by row,
    or choose sample data.
    Returns a 2-D list of numbers.
    """
    print("\n2D Data Input Options:")
    print("  1. Enter values manually")
    print("  2. Use sample data  [[3,1,4],[1,5,9],[2,6,5]]")
    choice = input("Choose an option: ").strip()

    if choice == "2":
        data_2d = [[3, 1, 4], [1, 5, 9], [2, 6, 5]]
        print(f"Sample 2D data loaded: {data_2d}")
    else:
        rows = int(input("How many rows? "))
        data_2d = []
        for r in range(rows):
            raw = input(f"  Enter values for row {r+1} (space-separated): ")
            row = [float(x) if '.' in x else int(x) for x in raw.split()]
            data_2d.append(row)

    return data_2d


def display_2d_grid(data_2d):
    """
    Displays a 2-D list in a formatted grid structure.
    """
    print("\n2D List (Grid View):")
    col_width = 6
    for row in data_2d:
        print("  " + "".join(str(val).rjust(col_width) for val in row))


# =====================================================================
# I. Sorting Collection Data Types
# =====================================================================

def sort_1d_data(data, ascending=True):
    """
    Sorts a 1-D list using the list.sort() method (in-place).
    Returns the sorted list and a copy for display.
    ascending=True  → ascending order
    ascending=False → descending order
    """
    data_copy = data[:]          # copy to avoid mutating original reference
    data_copy.sort(reverse=not ascending)   # in-place sort
    return data_copy


def sort_2d_rows(data_2d, ascending=True):
    """
    Sorts rows in a 2-D list using the sorted() built-in function
    (returns a new sorted list, leaving the original unchanged).
    Each row is sorted independently.
    """
    sorted_2d = [sorted(row, reverse=not ascending) for row in data_2d]
    return sorted_2d


