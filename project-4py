# ---------- Global Variable (Requirement F) ----------
dataset_summary = {
    "total_values": 0,
    "overall_mean": 0.0
}

# =====================================================================
# A. Built-in Functions  +  B. User-defined Functions (UDF)
# =====================================================================

def display_data_summary(data):
    """
    Displays basic statistics about a 1-D list using Python built-in
    functions: len(), min(), max(), sum().
    Updates the global dataset_summary dictionary.
    """
    global dataset_summary

    total   = len(data)
    minimum = min(data)
    maximum = max(data)
    total_sum = sum(data)

    # Update global summary
    dataset_summary["total_values"] = total
    dataset_summary["overall_mean"] = round(total_sum / total, 2)

    print("\nData Summary:")
    print(f"- Total elements: {total}")
    print(f"- Minimum value : {minimum}")
    print(f"- Maximum value : {maximum}")
    print(f"- Sum of all values: {total_sum}")


def calculate_average(data):
    """
    User-defined function that calculates and returns the average
    of a list of numbers.
    """
    return sum(data) / len(data)


def find_duplicates(data):
    """
    User-defined function that finds and returns duplicate values
    in a 1-D list.
    """
    seen = set()
    duplicates = set()
    for item in data:
        if item in seen:
            duplicates.add(item)
        seen.add(item)
    return list(duplicates)


def display_unique_values(data):
    """
    User-defined function that displays unique values from the list.
    """
    unique = list(set(data))
    print(f"\nUnique values: {unique}")


