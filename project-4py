# =====================================================================
# D. Recursion
# =====================================================================

def factorial(n):
    """
    Recursively calculates the factorial of a non-negative integer n.
    Base case : factorial(0) = 1
    Recursive  : factorial(n) = n * factorial(n-1)
    """
    if n < 0:
        raise ValueError("Factorial is not defined for negative numbers.")
    if n == 0:
        return 1
    return n * factorial(n - 1)


def fibonacci(n):
    """
    Recursively returns the n-th Fibonacci number (0-indexed).
    Base cases : fibonacci(0) = 0, fibonacci(1) = 1
    Recursive  : fibonacci(n) = fibonacci(n-1) + fibonacci(n-2)
    """
    if n < 0:
        raise ValueError("Fibonacci is not defined for negative indices.")
    if n == 0:
        return 0
    if n == 1:
        return 1
    return fibonacci(n - 1) + fibonacci(n - 2)


# =====================================================================
# E. Lambda Functions  (with map() and filter())
# =====================================================================

def filter_by_threshold(data, threshold):
    """
    Uses a lambda function together with filter() to return only those
    values in 'data' that are >= threshold.
    """
    filter_func = lambda x: x >= threshold          # lambda definition
    filtered    = list(filter(filter_func, data))   # filter() usage
    return filtered


def double_values(data):
    """
    Uses a lambda function together with map() to double every value
    in the list and return the result.
    """
    double_func = lambda x: x * 2
    doubled     = list(map(double_func, data))
    return doubled


# =====================================================================
# G. Return Multiple Values
# =====================================================================

def get_dataset_statistics(data):
    """
    Returns multiple statistics about the dataset as a tuple:
    (minimum, maximum, total_sum, average).
    Demonstrates returning multiple values from a single function.
    """
    minimum   = min(data)
    maximum   = max(data)
    total_sum = sum(data)
    average   = round(calculate_average(data), 2)
    return minimum, maximum, total_sum, average   # multiple return values


